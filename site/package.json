{
  "name": "filee-site",
  "version": "1.0.0",
  "private": true,
  "description": "filee.sh: the Filee website (static, deployed to Cloudflare Workers static assets)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
