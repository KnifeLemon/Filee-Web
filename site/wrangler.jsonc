// Cloudflare Workers (static assets only, no Worker script): serves dist/ on filee.sh.
// Deploy: npm run deploy (or connect the repo in Workers Builds, see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filee-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /ko → /ko/, /ko/index.html → /ko/
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "filee.sh", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": true
}
